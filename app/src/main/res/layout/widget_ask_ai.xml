<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ask_widget_root" android:layout_width="match_parent"
    android:layout_height="match_parent" android:orientation="vertical"
    android:gravity="center_vertical" android:padding="12dp"
    android:background="#FF20242B">
    <TextView android:id="@+id/ask_widget_title" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="اسأل Mi_Max Ai"
        android:textSize="15sp" android:textStyle="bold" android:textColor="#FFFFFFFF"/>
    <TextView android:id="@+id/ask_widget_subtitle" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="اضغط لبدء سؤال جديد"
        android:textSize="11sp" android:textColor="#FFB0B8C4" android:paddingTop="3dp"/>
    <TextView android:id="@+id/ask_widget_button" android:layout_width="match_parent"
        android:layout_height="34dp" android:layout_marginTop="8dp"
        android:gravity="center" android:text="اسأل الآن" android:textSize="12sp"
        android:textColor="#FFFFFFFF" android:background="#FF7FA6C9"/>
</LinearLayout>
